}: {
  layers: { src: string; className: string }[];
}): JSX.Element => {
  return (
    <span className="relative w-4 h-4" aria-hidden="true">
      {layers.map((layer, index) => (
        <img
          key={`${layer.src}-${index}`}
          className={layer.className}
          alt=""
          src={layer.src}
        />
      ))}
    </span>
  );
};

